  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "value",
        "unit",
        "population",
        "window",
        "threshold",
        "verdict",
        "reason",
        "evidence"
      ],
      "properties": {
        "state": {
          "enum": [
            "measured",
            "not_applicable",
            "not_measured",
            "unknown",
            "unreliable"
          ]
        },
        "value": {},
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "population": {
          "type": "string",
          "minLength": 1
        },
        "window": {
          "type": "string",
          "minLength": 1
        },
        "threshold": {},
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "inconclusive",
            "not_applicable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "measured"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "not": {
                  "type": "null"
                }
              },
              "evidence": {
                "minItems": 1
              }
